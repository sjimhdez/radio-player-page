{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "radplapag/now-playing",
  "version": "1.0.0",
  "title": "RPP: On Air",
  "category": "widgets",
  "description": "Display the radio show on air for a station, with its time slot, and the next radio show if it starts within 10 minutes.",
  "textdomain": "radio-player-page",
  "editorScript": "file:./build/index.js",
  "render": "file:./render.php",
  "attributes": {
    "stationId": {
      "type": "number",
      "default": 0
    },
    "stationIndex": {
      "type": "number",
      "default": 0
    },
    "showLogo": {
      "type": "boolean",
      "default": true
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    }
  },
  "supports": {
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "text": true,
      "background": true
    },
    "html": false
  }
}
