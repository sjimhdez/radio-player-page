<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/php/integration/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	failOnWarning="true"
	convertDeprecationsToExceptions="true"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/php/integration</directory>
		</testsuite>
		<!-- Also here so the coverage report counts the pure core (ADR 0028). -->
		<testsuite name="unit">
			<directory suffix="Test.php">tests/php/unit</directory>
		</testsuite>
	</testsuites>
	<groups>
		<exclude>
			<!-- Multisite tests run with `npm run test:php:integration:ms`. -->
			<group>ms-required</group>
			<!-- Unit tests that assert WordPress is not loaded. -->
			<group>no-wordpress</group>
		</exclude>
	</groups>
	<coverage includeUncoveredFiles="true">
		<include>
			<directory suffix=".php">includes</directory>
			<directory suffix=".php">admin</directory>
			<file>radio-player-page.php</file>
			<file>uninstall.php</file>
			<file>blocks/schedule/render.php</file>
			<file>blocks/programs-list/render.php</file>
			<file>blocks/now-playing/render.php</file>
		</include>
	</coverage>
</phpunit>
