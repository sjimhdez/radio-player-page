{
	"name": "radio-player-page-dev",
	"version": "3.4.2",
	"private": true,
	"description": "Development tooling for the WordPress side of Radio Player Page. The player (player/) and each block (blocks/*) are independent projects.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop && wp-env --config .wp-env.tests.json stop",
		"env:start:min": "WP_ENV_CORE=WordPress/WordPress#6.6-branch WP_ENV_PHP_VERSION=7.4 wp-env --config .wp-env.tests.json start --update",
		"env:start:latest": "wp-env --config .wp-env.tests.json start --update",
		"env:reset": "wp-env --config .wp-env.tests.json reset all",
		"wp-env:tests": "wp-env --config .wp-env.tests.json",
		"lint:php": "vendor/bin/phpcs -q",
		"format:php": "vendor/bin/phpcbf -q",
		"test:php:unit": "vendor/bin/phpunit",
		"test:php:integration": "wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/plugins/radio-player-page env WORDPRESS_TABLE_PREFIX=wptests_ vendor/bin/phpunit -c phpunit-integration.xml.dist",
		"test": "TZ=UTC vitest run",
		"test:coverage": "TZ=UTC vitest run --coverage",
		"lint:js": "eslint .",
		"test:e2e": "playwright test",
		"check:zip": "bash tests/zip/compare-with-v3.4.2.sh"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@vitest/coverage-v8": "5.0.5",
		"@wordpress/env": "11.17.0",
		"@wordpress/eslint-plugin": "27.1.0",
		"@wordpress/prettier-config": "4.57.0",
		"eslint": "10.13.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"vitest": "5.0.5"
	},
	"prettier": "@wordpress/prettier-config"
}
