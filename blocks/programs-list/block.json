{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "radplapag/programs-list",
  "version": "1.0.0",
  "title": "Programs List",
  "category": "widgets",
  "description": "Display all programs for a selected radio station with name, image, extended description, and broadcast schedule.",
  "textdomain": "radio-player-page",
  "attributes": {
    "stationIndex": {
      "type": "number",
      "default": 0
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showExtendedDescription": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "text": true,
      "background": true
    },
    "html": false
  }
}
